# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Railway: use the internal host shown in your Postgres service's "Connect" tab
#   e.g. postgres.railway.internal  (NOT the public URL of your FastAPI service)
# Local docker-compose: use "postgres" (the service name)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=globant_analytics
POSTGRES_USER=globant
POSTGRES_PASSWORD=change_me

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_KEY=change_me
BACKUP_DIR=backups
BRONZE_DIR=data/bronze

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=your@email.com
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me

# Server-to-server URL (FastAPI backend → Airflow). Never reaches the browser.
# Local docker-compose: http://airflow-webserver:8080
# Railway:              http://<airflow-service-name>.railway.internal:8080
AIRFLOW_URL=http://airflow-webserver:8080

# Public URL the browser opens when clicking "Open Airflow ↗"
# Local: http://localhost:8080
# Railway: https://<airflow-service-name>.up.railway.app
AIRFLOW_PUBLIC_URL=http://localhost:8080

# ── Metabase ──────────────────────────────────────────────────────────────────
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me

# Server-to-server URL (FastAPI backend → Metabase). Never reaches the browser.
# Local docker-compose: http://metabase:3000
# Railway:              http://<metabase-service-name>.railway.internal:3000
METABASE_URL=http://metabase:3000

# Public URL the browser uses to load the embedded dashboard
# Local: http://localhost:3000
# Railway: https://<metabase-service-name>.up.railway.app
METABASE_PUBLIC_URL=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
