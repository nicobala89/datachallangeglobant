# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=globant
POSTGRES_PASSWORD=change_me
POSTGRES_DB=globant_analytics
# For local development outside Docker; ignored when running inside docker-compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── FastAPI ───────────────────────────────────────────────────────────────────
# Protects all write endpoints (X-API-Key header)
API_KEY=change_me

# Directories (relative to the container's WORKDIR /app)
BACKUP_DIR=backups
BRONZE_DIR=data/bronze

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=your@email.com

# Fernet key for Airflow secret encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=change_me

# Public URL the browser uses to open Airflow directly (e.g. Railway public domain)
# Leave as localhost for local docker-compose usage
AIRFLOW_PUBLIC_URL=http://localhost:8080

# ── Metabase ──────────────────────────────────────────────────────────────────
METABASE_ADMIN_EMAIL=admin@example.com
METABASE_ADMIN_PASSWORD=change_me

# Public URL the browser uses to load the embedded dashboard
# Leave as localhost for local docker-compose usage
METABASE_PUBLIC_URL=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
