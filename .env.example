# =============================================================================
# LOCAL DEVELOPMENT  (docker-compose)
# =============================================================================
# Copy this file to .env and fill in the values marked <change_me>.
# The defaults below match the docker-compose service names so everything
# works out of the box without editing, except secrets marked <change_me>.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres          # docker-compose service name
POSTGRES_PORT=5432
POSTGRES_DB=globant_analytics
POSTGRES_USER=globant
POSTGRES_PASSWORD=<change_me>

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_KEY=<change_me>
BACKUP_DIR=backups
BRONZE_DIR=data/bronze

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=<change_me>
AIRFLOW_ADMIN_EMAIL=your@email.com
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<change_me>
# Internal docker-compose hostname; browser links use http://localhost:8080
AIRFLOW_URL=http://airflow-webserver:8080

# ── Metabase ──────────────────────────────────────────────────────────────────
METABASE_ADMIN_EMAIL=your@email.com
METABASE_ADMIN_PASSWORD=<change_me>
# Internal docker-compose hostname; browser embed uses http://localhost:3000
METABASE_URL=http://metabase:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO


# =============================================================================
# RAILWAY DEPLOYMENT
# =============================================================================
# Set these in each Railway service's "Variables" panel.
# ${{Service.VAR}} is Railway's template syntax — it pulls the value directly
# from another service so you never have to copy-paste connection strings.

# ── PostgreSQL (Railway managed Postgres plugin) ──────────────────────────────
# POSTGRES_HOST=${{Postgres.PGHOST_PRIVATE}}   ← private networking (faster)
# POSTGRES_PORT=${{Postgres.PGPORT}}
# POSTGRES_DB=${{Postgres.PGDATABASE}}         ← resolves to "railway"
# POSTGRES_USER=${{Postgres.PGUSER}}
# POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}

# ── FastAPI service ───────────────────────────────────────────────────────────
# API_KEY=<change_me>
# BACKUP_DIR=backups
# BRONZE_DIR=data/bronze
#
# AIRFLOW_URL=https://<your-airflow-service>.up.railway.app
# METABASE_URL=https://<your-metabase-service>.up.railway.app
# METABASE_ADMIN_EMAIL=<same as Metabase service>
# METABASE_ADMIN_PASSWORD=<same as Metabase service>
#
# Note: AIRFLOW_PUBLIC_URL / METABASE_PUBLIC_URL are NOT needed separately.
# The app falls back to AIRFLOW_URL / METABASE_URL for browser links too.

# ── Airflow service ───────────────────────────────────────────────────────────
# POSTGRES_HOST=${{Postgres.PGHOST_PRIVATE}}
# POSTGRES_PORT=${{Postgres.PGPORT}}
# POSTGRES_DB=${{Postgres.PGDATABASE}}
# POSTGRES_USER=${{Postgres.PGUSER}}
# POSTGRES_PASSWORD=${{Postgres.PGPASSWORD}}
# AIRFLOW_FERNET_KEY=<same key as local — generate once, reuse>
# AIRFLOW_ADMIN_USERNAME=admin
# AIRFLOW_ADMIN_PASSWORD=<change_me>
# AIRFLOW_ADMIN_EMAIL=your@email.com
# _AIRFLOW_WWW_USER_CREATE=true
# _AIRFLOW_WWW_USER_USERNAME=admin
# _AIRFLOW_WWW_USER_PASSWORD=<change_me>
# AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST_PRIVATE}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
# AIRFLOW__CORE__EXECUTOR=LocalExecutor
# AIRFLOW__CORE__LOAD_EXAMPLES=false
# AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth

# ── Metabase service (image: metabase/metabase:latest) ───────────────────────
# MB_DB_TYPE=h2
# JAVA_TIMEZONE=UTC
